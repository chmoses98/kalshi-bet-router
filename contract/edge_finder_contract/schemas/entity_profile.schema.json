              "OPPONENT",
              "METRIC",
              "RANKING",
              "SERIES",
              "MARKET",
              "MARKET_HISTORY",
              "EVENT_RESEARCH",
              "CAPABILITIES",
              "SEARCH",
              "INDEX"
            ],
            "type": "string"
          },
          "target_id": {
