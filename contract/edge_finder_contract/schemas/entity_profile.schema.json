                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "enum": [
                  "SEASON",
                  "LAST_N",
                  "DATE_RANGE",
                  "GAME",
                  "RUN",
                  "CUSTOM"
                ],
                "type": "string"
              },
              "label": {
                "description": "SEASON, L3, L5, 2026-W04, run 2026-10-02T14:40Z ...",
                "type": "string"
              },
              "n": {
                "description": "LAST_N size",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "start": {
                "description": "ISO-8601 UTC, Z suffix, or null",
                "format": "date-time",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "end",
              "kind",
              "label",
              "n",
              "start"
            ],
            "type": "object"
          }
        },
        "required": [
