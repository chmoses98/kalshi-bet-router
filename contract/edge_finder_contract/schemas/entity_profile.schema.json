                "required": [
                  "dimension",
                  "value"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "sport": {
            "description": "canonical sport",
            "enum": [
              "MLB",
              "CFB",
              "NFL",
              "NBA",
              "NHL",
              "SOCCER",
              "TENNIS"
