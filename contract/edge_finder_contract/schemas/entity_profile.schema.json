                    "description": "",
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "worst_entity_id": {
                    "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
                    "type": [
                      "string",
                      "null"
                    ]
