          "as_of",
          "context",
          "display_value",
          "entity_id",
          "entity_type",
          "event_id",
          "extensions",
          "metric_id",
          "observation_id",
          "opponent_id",
          "quality_status",
          "sample_size",
          "season",
          "source",
          "split",
          "sport",
          "unit",
          "value",
          "window"
