          },
          "freshness_status": {
            "enum": [
              "FRESH",
              "AGING",
              "STALE",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "generated_at": {
            "description": "ISO-8601 UTC, Z suffix",
            "format": "date-time",
            "type": "string"
          },
          "inputs_as_of": {
            "description": "the newest input the model saw",
            "format": "date-time",
            "type": [
              "string",
              "null"
