          "run_id": {
            "description": "a contract id",
            "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
            "type": "string"
          },
          "support_status": {
            "description": "the source repository's support / gate label, verbatim",
            "type": [
              "string",
              "null"
            ]
          },
          "uncertainty": {
            "description": "standard error or interval half-width when the model computes one; never invented",
            "type": [
              "number",
              "null"
            ]
          },
          "upper_bound": {
            "description": "",
            "maximum": 1,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "data_quality_status",
          "edge",
          "event_id",
          "extensions",
          "fair_probability",
          "freshness_status",
          "generated_at",
          "inputs_as_of",
          "lower_bound",
          "market_id",
          "market_probability",
          "model_price_id",
          "model_version",
