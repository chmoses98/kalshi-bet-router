{
  "$id": "https://edge-finder.app/schemas/edge_finder.app.v1/event_detail",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context": {
      "additionalProperties": true,
      "description": "injuries / lineups / weather / usage, sport-specific",
      "type": "object"
    },
    "data_freshness": {
      "enum": [
        "FRESH",
        "AGING",
        "STALE",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "event": {
      "additionalProperties": false,
      "properties": {
        "away_participant": {
          "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
          "type": [
            "string",
            "null"
          ]
        },
        "broadcast": {
          "type": [
            "string",
            "null"
          ]
        },
        "competition": {
          "description": "competition / tournament / week label where distinct from league",
          "type": [
            "string",
            "null"
          ]
        },
        "effective_start_time_utc": {
          "description": "the best current estimate of the actual start, when it differs",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "event_id": {
          "description": "a contract id",
          "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
          "type": "string"
        },
        "extensions": {
          "additionalProperties": true,
          "description": "sport-specific detail the common fields do not carry; never required by the UI",
          "type": "object"
        },
        "home_participant": {
          "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
          "type": [
            "string",
            "null"
          ]
        },
        "last_updated_at": {
          "description": "when this record was built",
          "format": "date-time",
          "type": "string"
        },
        "league": {
          "description": "display league / tour, e.g. NFL, Premier League, ATP",
          "type": [
            "string",
            "null"
          ]
        },
        "participants": {
          "description": "every participant; the durable abstraction (tennis has no home/away)",
          "items": {
            "additionalProperties": false,
            "properties": {
              "display_name": {
                "type": "string"
              },
              "metadata": {
                "additionalProperties": true,
                "description": "conference, country, ranking, seed, jersey ... never required",
                "type": "object"
              },
              "participant_id": {
                "description": "a contract id",
                "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
                "type": "string"
              },
              "participant_type": {
                "enum": [
                  "TEAM",
                  "PLAYER",
                  "PAIR"
                ],
                "type": "string"
              },
              "short_name": {
                "description": "abbreviation or surname",
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_ids": {
                "additionalProperties": {
                  "type": [
                    "string",
                    "integer",
                    "null"
                  ]
                },
                "description": "provider id namespace -> provider id (kalshi, espn, nflverse, mlb_game_pk ...)",
                "type": "object"
              }
            },
            "required": [
              "display_name",
              "metadata",
              "participant_id",
              "participant_type",
              "short_name",
              "source_ids"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "schedule_updated_at": {
          "description": "when the schedule source was last read",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "season": {
          "description": "season label as the source states it, e.g. 2026, 2026-27",
          "type": [
            "string",
            "null"
          ]
        },
        "source_ids": {
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "description": "provider id namespace -> provider id (kalshi, espn, nflverse, mlb_game_pk ...)",
          "type": "object"
        },
        "sport": {
          "description": "canonical sport",
          "enum": [
            "MLB",
            "CFB",
            "NFL",
            "NBA",
            "NHL",
            "SOCCER",
            "TENNIS",
            "CBB"
          ],
          "type": "string"
        },
        "start_time_confidence": {
          "description": "PLACEHOLDER = a Kalshi nominal time, not a schedule",
          "enum": [
            "SCHEDULED",
            "VERIFIED",
            "ESTIMATED",
            "PLACEHOLDER",
            "UNKNOWN",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "start_time_local": {
          "description": "ISO-8601 with the venue's offset when the source knows it",
          "type": [
            "string",
            "null"
          ]
        },
        "start_time_source": {
          "description": "which provider supplied the start time",
          "type": [
            "string",
            "null"
          ]
        },
        "start_time_utc": {
          "description": "scheduled start, UTC",
          "format": "date-time",
          "type": "string"
        },
        "status": {
          "enum": [
            "SCHEDULED",
            "LIVE",
            "FINAL",
            "POSTPONED",
            "CANCELLED",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "venue": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "away_participant",
        "broadcast",
        "competition",
        "effective_start_time_utc",
        "event_id",
        "extensions",
        "home_participant",
        "last_updated_at",
        "league",
        "participants",
        "schedule_updated_at",
        "season",
        "source_ids",
        "sport",
        "start_time_confidence",
        "start_time_local",
        "start_time_source",
        "start_time_utc",
        "status",
        "venue"
      ],
      "type": "object"
    },
    "generated_at": {
      "description": "ISO-8601 UTC, Z suffix",
      "format": "date-time",
      "type": "string"
    },
    "kind": {
      "const": "event_detail"
    },
    "markets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "captured_at": {
            "description": "when the quote was observed; null only for a stub of a market no longer on the board",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "close_time_utc": {
            "description": "ISO-8601 UTC, Z suffix, or null",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "event_id": {
            "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
            "type": [
              "string",
              "null"
            ]
          },
          "extensions": {
            "additionalProperties": true,
            "description": "sport-specific detail the common fields do not carry; never required by the UI",
            "type": "object"
          },
          "kalshi_event_ticker": {
            "type": [
              "string",
              "null"
            ]
          },
          "kalshi_series_ticker": {
            "type": [
              "string",
              "null"
            ]
          },
          "kalshi_ticker": {
            "type": "string"
          },
          "last_price": {
            "description": "",
            "maximum": 1,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "line": {
            "description": "spread / total / handicap line",
            "type": [
              "number",
              "null"
            ]
          },
          "market_family": {
            "description": "the source repository's family label, normalised to lower snake_case",
            "type": "string"
          },
          "market_id": {
            "description": "a contract id",
            "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
            "type": "string"
          },
          "market_probability": {
            "description": "mid of the YES book in [0,1]; null when the book is empty",
            "maximum": 1,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "market_status": {
            "enum": [
              "OPEN",
              "CLOSED",
              "SETTLED",
              "UNOPENED",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "market_type": {
            "description": "finer type where the family is broad",
            "type": [
              "string",
              "null"
            ]
          },
          "no_ask": {
            "description": "",
            "maximum": 1,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "no_bid": {
            "description": "",
            "maximum": 1,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "no_description": {
            "type": [
              "string",
              "null"
            ]
          },
          "open_interest": {
            "type": [
              "number",
              "null"
            ]
          },
          "participant_id": {
            "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
            "type": [
              "string",
              "null"
            ]
          },
          "period": {
            "description": "FULL_GAME, FIRST_HALF, F5, SET_1 ... as the source labels it",
            "type": [
              "string",
              "null"
            ]
          },
          "player_id": {
            "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
            "type": [
              "string",
              "null"
            ]
          },
          "raw_market_reference": {
            "description": "where the raw record lives in the source repository",
            "type": [
              "string",
              "null"
            ]
          },
          "side": {
            "description": "what YES refers to, when the family has sides",
            "enum": [
              "HOME",
              "AWAY",
              "DRAW",
              "OVER",
              "UNDER",
              "PARTICIPANT",
              "TIE",
              "OTHER",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "description": "which capture produced the quote",
            "type": "string"
          },
          "sport": {
            "description": "canonical sport",
            "enum": [
              "MLB",
              "CFB",
              "NFL",
              "NBA",
              "NHL",
              "SOCCER",
              "TENNIS",
              "CBB"
            ],
            "type": "string"
          },
          "threshold": {
            "description": "prop threshold (YES iff stat >= / > threshold as yes_description states)",
            "type": [
              "number",
              "null"
            ]
          },
          "volume": {
            "type": [
              "number",
              "null"
            ]
          },
          "yes_ask": {
            "description": "",
            "maximum": 1,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "yes_bid": {
            "description": "",
            "maximum": 1,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "yes_description": {
            "description": "what YES means, in words",
            "type": "string"
          }
        },
        "required": [
          "captured_at",
          "close_time_utc",
          "event_id",
          "extensions",
          "kalshi_event_ticker",
          "kalshi_series_ticker",
          "kalshi_ticker",
          "last_price",
          "line",
          "market_family",
          "market_id",
          "market_probability",
          "market_status",
          "market_type",
          "no_ask",
          "no_bid",
          "no_description",
          "open_interest",
          "participant_id",
          "period",
          "player_id",
          "raw_market_reference",
          "side",
          "source",
          "sport",
          "threshold",
          "volume",
          "yes_ask",
          "yes_bid",
          "yes_description"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "model_prices": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "data_quality_status": {
            "enum": [
              "OK",
              "DEGRADED",
              "CANNOT_TRUST_INPUTS",
              "UNSUPPORTED",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "edge": {
            "description": "fair_probability - market_probability on the YES side, when both exist",
