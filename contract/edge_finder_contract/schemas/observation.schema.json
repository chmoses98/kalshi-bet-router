{
  "$id": "https://edge-finder.app/schemas/edge_finder.app.v1/observation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adjusted_value": {
      "description": "opponent/schedule-adjusted value when the source computes one; never invented",
      "type": [
        "number",
        "null"
      ]
    },
    "as_of": {
      "description": "ISO-8601 UTC, Z suffix",
      "format": "date-time",
      "type": "string"
    },
    "context": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "the comparison context that makes a number meaningful; never a bare percentile",
          "properties": {
            "best_entity_id": {
              "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
              "type": [
                "string",
                "null"
              ]
            },
            "best_value": {
              "type": [
                "number",
                "null"
              ]
            },
            "higher_is_better": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "league_average": {
              "type": [
                "number",
                "null"
              ]
            },
            "league_median": {
              "type": [
                "number",
                "null"
              ]
            },
            "percentile": {
              "description": "0..100, 100 = best",
              "type": [
                "number",
                "null"
              ]
            },
            "rank": {
              "description": "1 = best per higher_is_better",
              "type": [
                "integer",
                "null"
              ]
            },
            "ranking_id": {
              "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
              "type": [
                "string",
                "null"
              ]
            },
            "universe_label": {
              "type": [
                "string",
                "null"
              ]
            },
            "universe_size": {
              "description": "",
              "type": [
                "integer",
                "null"
              ]
            },
            "worst_entity_id": {
              "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
              "type": [
                "string",
                "null"
              ]
            },
            "worst_value": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "best_entity_id",
            "best_value",
            "higher_is_better",
            "league_average",
            "league_median",
            "percentile",
            "rank",
            "ranking_id",
            "universe_label",
            "universe_size",
            "worst_entity_id",
            "worst_value"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "display_value": {
      "type": [
        "string",
        "null"
      ]
    },
    "entity_id": {
      "description": "a contract id",
      "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
      "type": "string"
    },
    "entity_type": {
      "enum": [
        "TEAM",
        "PLAYER",
        "EVENT",
        "MARKET",
        "MATCHUP"
      ],
      "type": "string"
    },
    "event_id": {
      "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "additionalProperties": true,
      "description": "sport-specific detail the common fields do not carry; never required by the UI",
      "type": "object"
    },
    "metric_id": {
      "description": "met_<sport>.<slug>",
      "pattern": "^met_[a-z]+\\.[a-z0-9_]+$",
      "type": "string"
    },
    "observation_id": {
      "description": "a contract id",
      "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
      "type": "string"
    },
    "opponent_id": {
      "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
      "type": [
        "string",
        "null"
      ]
    },
    "quality_status": {
      "description": "VERIFIED = production-generated on a cadence, tested, history present; PARTIAL = real but limited; RESEARCH = non-production or experimental; UNAVAILABLE = nothing supports it; UNKNOWN = not established",
      "enum": [
        "VERIFIED",
        "PARTIAL",
        "RESEARCH",
        "UNAVAILABLE",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "sample_size": {
      "description": "games, plays, PA, minutes ... in the metric's sample unit",
      "type": [
        "integer",
        "null"
      ]
    },
    "season": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string"
    },
    "split": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "dimension": {
              "description": "home_away, handedness, strength_state, surface ...",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "dimension",
            "value"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "sport": {
      "description": "canonical sport",
      "enum": [
        "MLB",
        "CFB",
        "NFL",
        "NBA",
        "NHL",
        "SOCCER",
        "TENNIS"
      ],
      "type": "string"
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "value": {
      "description": "the raw value; null when the source has none for this window",
      "type": [
        "number",
        "null"
      ]
    },
    "window": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "description": "ISO-8601 UTC, Z suffix, or null",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "SEASON",
            "LAST_N",
            "DATE_RANGE",
            "GAME",
            "RUN",
            "CUSTOM"
          ],
          "type": "string"
        },
        "label": {
          "description": "SEASON, L3, L5, 2026-W04, run 2026-10-02T14:40Z ...",
          "type": "string"
        },
        "n": {
          "description": "LAST_N size",
          "type": [
            "integer",
            "null"
          ]
        },
        "start": {
          "description": "ISO-8601 UTC, Z suffix, or null",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "end",
        "kind",
        "label",
        "n",
        "start"
      ],
      "type": "object"
    }
  },
  "required": [
    "adjusted_value",
    "as_of",
    "context",
    "display_value",
    "entity_id",
    "entity_type",
    "event_id",
    "extensions",
    "metric_id",
    "observation_id",
    "opponent_id",
    "quality_status",
    "sample_size",
    "season",
    "source",
    "split",
    "sport",
    "unit",
    "value",
    "window"
  ],
  "title": "observation",
  "type": "object"
}
