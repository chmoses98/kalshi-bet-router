      "enum": [
        "HEALTHY",
        "DEGRADED",
        "STALE",
        "UNAVAILABLE",
        "RESEARCH_ONLY"
      ],
      "type": "string"
    },
    "poll_age_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "router_health_state": {
      "enum": [
        "healthy_no_op",
        "delivered",
        "not_routable",
        "deferred",
        "blocked",
        "unknown"
      ],
      "type": "string"
    },
    "run_id": {
      "description": "a contract id",
      "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
      "type": "string"
    },
    "schema_version": {
      "const": "edge_finder.app.v1"
    },
    "sport": {
      "enum": [
        "MLB",
        "CFB",
        "NFL",
        "NBA",
        "NHL",
        "SOCCER",
        "TENNIS",
        "CBB",
        "ALL"
      ],
      "type": "string"
    },
    "thresholds": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "fresh_after_seconds": {
            "type": "integer"
