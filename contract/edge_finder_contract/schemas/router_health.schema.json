          "fresh_after_seconds",
          "stale_after_seconds"
        ],
        "type": "object"
      },
      "type": "object"
    },
    "waiting_for_parent_wager": {
      "description": "settlements withheld because their wager is on an open, unmerged proposal",
      "type": [
        "integer",
        "null"
      ]
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
