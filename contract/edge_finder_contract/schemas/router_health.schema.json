      "description": "",
      "type": [
        "integer",
        "null"
      ]
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "failed": {
      "description": "",
      "type": [
        "integer",
        "null"
      ]
    },
    "generated_at": {
      "description": "ISO-8601 UTC, Z suffix",
      "format": "date-time",
      "type": "string"
    },
    "kind": {
      "const": "router_health"
    },
    "last_delivery_run": {
      "additionalProperties": false,
      "properties": {
        "concluded_at": {
          "description": "ISO-8601 UTC, Z suffix, or null",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "conclusion": {
          "type": [
            "string",
            "null"
          ]
        },
        "health_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "description": "ISO-8601 UTC, Z suffix, or null",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "concluded_at",
        "conclusion",
        "health_state",
        "run_id",
        "started_at",
        "url"
      ],
      "type": "object"
    },
    "last_poll_at": {
      "description": "ISO-8601 UTC, Z suffix, or null",
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "last_settlement_run": {
      "additionalProperties": false,
      "properties": {
        "concluded_at": {
          "description": "ISO-8601 UTC, Z suffix, or null",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "conclusion": {
          "type": [
            "string",
            "null"
          ]
        },
        "health_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "description": "ISO-8601 UTC, Z suffix, or null",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "concluded_at",
        "conclusion",
        "health_state",
        "run_id",
        "started_at",
        "url"
      ],
      "type": "object"
