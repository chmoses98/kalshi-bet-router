{
  "$id": "https://edge-finder.app/schemas/edge_finder.app.v1/search_index",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "count": {
      "minimum": 0,
      "type": "integer"
    },
    "generated_at": {
      "description": "ISO-8601 UTC, Z suffix",
      "format": "date-time",
      "type": "string"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "context": {
            "additionalProperties": false,
            "properties": {
              "league": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "position": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "season": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "team": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "league",
              "position",
              "season",
              "team"
            ],
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "TEAM",
              "PLAYER",
              "EVENT",
              "METRIC",
              "RANKING",
              "SERIES"
            ],
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "secondary": {
            "description": "position, team, competition ...",
            "type": [
              "string",
              "null"
            ]
          },
          "sport": {
            "description": "canonical sport",
            "enum": [
              "MLB",
              "CFB",
              "NFL",
              "NBA",
              "NHL",
              "SOCCER",
              "TENNIS",
              "CBB"
            ],
            "type": "string"
          },
          "tokens": {
            "description": "lowercase, deduplicated, sorted",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "aliases",
          "context",
          "id",
          "kind",
          "label",
          "path",
          "secondary",
          "sport",
          "tokens"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "kind": {
      "const": "search_index"
    },
    "run_id": {
      "description": "a contract id",
      "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
      "type": "string"
    },
    "schema_version": {
      "const": "edge_finder.app.v1"
    },
    "sport": {
      "description": "canonical sport",
      "enum": [
        "MLB",
        "CFB",
        "NFL",
        "NBA",
        "NHL",
        "SOCCER",
        "TENNIS",
        "CBB"
      ],
      "type": "string"
    }
  },
  "required": [
    "count",
    "generated_at",
    "items",
    "kind",
    "run_id",
    "schema_version",
    "sport"
  ],
  "title": "search_index",
  "type": "object"
}
