{
  "$id": "https://edge-finder.app/schemas/edge_finder.app.v1/time_series",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "description": "ISO-8601 UTC, Z suffix",
      "format": "date-time",
      "type": "string"
    },
    "entity_id": {
      "description": "a contract id",
      "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
      "type": "string"
    },
    "entity_type": {
      "enum": [
        "TEAM",
        "PLAYER",
        "EVENT",
        "MARKET",
        "MATCHUP"
      ],
      "type": "string"
    },
    "generated_at": {
      "description": "ISO-8601 UTC, Z suffix",
      "format": "date-time",
      "type": "string"
    },
    "kind": {
      "const": "time_series"
    },
    "links": {
      "items": {
        "additionalProperties": false,
        "description": "a navigable edge; every path must exist in explorer/index.json",
        "properties": {
          "label": {
            "type": "string"
          },
          "path": {
            "description": "app-root-relative path of the target document; null only when the target is embedded",
            "type": [
              "string",
              "null"
            ]
          },
          "rel": {
            "enum": [
              "TEAM",
              "PLAYER",
              "EVENT",
              "OPPONENT",
              "METRIC",
              "RANKING",
              "SERIES",
              "MARKET",
              "MARKET_HISTORY",
              "EVENT_RESEARCH",
              "CAPABILITIES",
              "SEARCH",
              "INDEX"
            ],
            "type": "string"
          },
          "target_id": {
            "description": "the contract id of the target, when it has one",
            "type": [
              "string",
              "null"
            ]
          },
          "target_kind": {
            "enum": [
              "manifest",
              "events",
              "markets",
              "model_prices",
              "recommendations",
              "theses",
              "wagers",
              "settlements",
              "runs",
              "health",
              "board",
              "event_detail",
              "performance",
              "router_health",
              "recent_deliveries",
              "sports_registry",
              "explorer_index",
              "capability_manifest",
              "metric_registry",
              "entity_profile",
              "event_research",
              "ranking",
              "time_series",
              "market_history",
              "search_index",
              "handicap_packet",
              "handicap_protocol",
              "research_tray"
            ],
            "type": "string"
          }
        },
        "required": [
          "label",
          "path",
          "rel",
          "target_id",
          "target_kind"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "metric_id": {
      "description": "met_<sport>.<slug>",
      "pattern": "^met_[a-z]+\\.[a-z0-9_]+$",
      "type": "string"
    },
    "points": {
      "description": "sorted by t ascending, then x",
      "items": {
        "additionalProperties": false,
        "properties": {
          "adjusted_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "event_id": {
            "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
            "type": [
              "string",
              "null"
            ]
          },
          "opponent_id": {
            "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "quality_status": {
            "description": "VERIFIED = production-generated on a cadence, tested, history present; PARTIAL = real but limited; RESEARCH = non-production or experimental; UNAVAILABLE = nothing supports it; UNKNOWN = not established",
            "enum": [
              "VERIFIED",
              "PARTIAL",
              "RESEARCH",
              "UNAVAILABLE",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "rolling_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "run_id": {
            "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
            "type": [
              "string",
              "null"
            ]
          },
          "sample_size": {
            "description": "",
            "type": [
              "integer",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "t": {
            "description": "ISO-8601 UTC, Z suffix",
            "format": "date-time",
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "x": {
            "description": "the x label: game id, week, date, run or capture label",
            "type": "string"
          }
        },
        "required": [
          "adjusted_value",
          "event_id",
          "opponent_id",
          "path",
          "quality_status",
          "rolling_value",
          "run_id",
          "sample_size",
          "source",
          "t",
          "value",
          "x"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "quality": {
      "additionalProperties": false,
      "description": "where a research object came from and how far to trust it",
      "properties": {
        "coverage": {
          "description": "human-readable span, e.g. 2026 weeks 1-4",
          "type": [
            "string",
            "null"
          ]
        },
        "data_as_of": {
          "description": "the newest underlying observation",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "generated_at": {
          "description": "ISO-8601 UTC, Z suffix",
          "format": "date-time",
          "type": "string"
        },
        "limitations": {
          "description": "known caveats, verbatim from the audit; never empty for PARTIAL/RESEARCH",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "methodology_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "missingness": {
          "description": "fraction of expected observations that are absent, 0..1",
          "type": [
            "number",
            "null"
          ]
        },
        "production": {
          "description": "produced by a scheduled production path, not a notebook or one-off",
          "type": "boolean"
        },
        "sample_size": {
          "description": "",
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "description": "the producing dataset or provider, e.g. nflverse pbp, kalshi captures, internal simulation",
          "type": "string"
        },
        "source_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "VERIFIED = production-generated on a cadence, tested, history present; PARTIAL = real but limited; RESEARCH = non-production or experimental; UNAVAILABLE = nothing supports it; UNKNOWN = not established",
          "enum": [
            "VERIFIED",
            "PARTIAL",
            "RESEARCH",
            "UNAVAILABLE",
            "UNKNOWN"
          ],
          "type": "string"
        }
      },
      "required": [
        "coverage",
        "data_as_of",
        "generated_at",
        "limitations",
        "methodology_version",
        "missingness",
        "production",
        "sample_size",
        "source",
        "source_version",
        "status"
      ],
      "type": "object"
    },
    "rolling_window": {
      "description": "",
      "type": [
        "integer",
        "null"
      ]
    },
    "run_id": {
      "description": "a contract id",
      "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
      "type": "string"
    },
    "schema_version": {
      "const": "edge_finder.app.v1"
    },
    "series_id": {
      "description": "a contract id",
      "pattern": "^[a-z]{2,4}_[A-Za-z0-9._-]{4,}$",
      "type": "string"
    },
    "split": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "dimension": {
              "description": "home_away, handedness, strength_state, surface ...",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "dimension",
            "value"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "sport": {
      "description": "canonical sport",
      "enum": [
        "MLB",
        "CFB",
        "NFL",
        "NBA",
        "NHL",
        "SOCCER",
        "TENNIS"
      ],
      "type": "string"
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "x_axis": {
      "enum": [
        "GAME",
        "WEEK",
        "DATE",
        "RUN",
        "CAPTURE"
      ],
      "type": "string"
    }
  },
  "required": [
    "as_of",
    "entity_id",
    "entity_type",
    "generated_at",
    "kind",
    "links",
    "metric_id",
    "points",
    "quality",
    "rolling_window",
    "run_id",
    "schema_version",
    "series_id",
    "split",
    "sport",
    "unit",
    "x_axis"
  ],
  "title": "time_series",
  "type": "object"
}
